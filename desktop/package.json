{
  "name":"alsarh-educational-desktop",
  "version":"0.1.0",
  "private":true,
  "description":"ALSARH Educational System - Windows client",
  "main":"main.cjs",
  "scripts":{"start":"electron .","build:win":"electron-builder --win nsis portable --x64"},
  "devDependencies":{"electron":"^33.4.11","electron-builder":"^25.1.8"},
  "build":{
    "appId":"com.alsarh.educational",
    "productName":"ALSARH Educational System",
    "asar":true,
    "files":["main.cjs","launcher.html","package.json"],
    "directories":{"output":"dist"},
    "win":{"target":["nsis","portable"],"artifactName":"alsarh-windows-${version}-${arch}.${ext}"},
    "nsis":{"oneClick":false,"perMachine":false,"allowToChangeInstallationDirectory":true}
  }
}
